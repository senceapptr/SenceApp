{
  "name": "expo-nativewind-typescript-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start -c --dev-client",
    "start:go": "REACT_NATIVE_PACKAGER_HOSTNAME=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo '127.0.0.1') npx expo start -c --go --lan",
    "start:tunnel": "npx expo start --tunnel",
    "start:tunnel:go": "npx expo start --tunnel --go",
    "android": "npx expo run:android",
    "android:prebuild": "npx expo prebuild && npx expo run:android",
    "ios": "PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" npx expo run:ios",
    "ios:prebuild": "PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" npx expo prebuild && npx expo run:ios",
    "ios:rebuild": "PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" npx expo run:ios --no-build-cache",
    "web": "npx expo start --web",
    "test": "npx jest --watchAll",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "clean": "rm -rf node_modules; rm -rf ios/build; rm -rf ios/build; rm -rf ios/Pods; rm -rf ios/Podfile.lock; rm -rf ~/Library/Developer/Xcode/DerivedData/",
    "lint": "eslint ."
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@supabase/supabase-js": "^2.76.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "date-fns": "^2.29.3",
    "dotenv": "^17.2.3",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "input-otp": "^1.4.2",
    "lottie-react-native": "~7.3.1",
    "nativewind": "^4.1.23",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.60.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-collapsible": "^1.6.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.73",
